<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="obstacle_course">
    <!-- Physics parameters -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Environment Lighting & Sky -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== ARENA BOUNDARY WALLS ==================== -->
    <model name="north_wall">
      <static>true</static>
      <pose>6.0 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>17.0 0.2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>17.0 0.2 1.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.3 1</ambient><diffuse>0.2 0.2 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>6.0 -3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>17.0 0.2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>17.0 0.2 1.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.3 1</ambient><diffuse>0.2 0.2 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>14.5 0.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 7.2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 7.2 1.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.3 1</ambient><diffuse>0.2 0.2 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-2.5 0.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 7.2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 7.2 1.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.3 1</ambient><diffuse>0.2 0.2 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== DEMO OBSTACLES ==================== -->
    <!-- Obstacle 1: Red Box on the Left (forces robot to steer right) -->
    <model name="obstacle_red_box">
      <static>true</static>
      <pose>2.5 0.6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 1.2</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Blue Cylinder on the Right (forces robot to steer left) -->
    <model name="obstacle_blue_cylinder">
      <static>true</static>
      <pose>5.2 -0.9 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.6</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.6</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Green Box in Center-Left -->
    <model name="obstacle_green_box">
      <static>true</static>
      <pose>8.0 0.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 1.2 1.2</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: Yellow Pillar on the Right -->
    <model name="obstacle_yellow_pillar">
      <static>true</static>
      <pose>11.0 -0.6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
